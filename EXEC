#!/usr/bin/env bash
# ARP Platform — launcher and installer (one executable, two names)
#   ./EXEC   — start the platform
#   ./SETUP  — one-time local install (hard-linked to this file)
# macOS Finder mislabels any file named "INSTALL" as plain text, so we use SETUP.
# Override defaults via env: DB_PATH, API_URL, OLLAMA_MODEL, ENABLE_ENHANCEMENTS, …

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

_RUN_AS="$(basename "${BASH_SOURCE[0]}")"

# shellcheck source=scripts/arp_mac_launch.sh
source "$ROOT_DIR/scripts/arp_mac_launch.sh"

if [[ "$_RUN_AS" == "SETUP" ]]; then
  arp_mac_launch_if_needed "$ROOT_DIR" "$ROOT_DIR/SETUP" 1
  exec "$ROOT_DIR/scripts/install_local.sh"
fi

arp_mac_launch_if_needed "$ROOT_DIR" "$ROOT_DIR/EXEC" 0

if [[ ! -d "$ROOT_DIR/.venv" ]]; then
  echo "ERROR: No .venv found. Run ./SETUP first (or ./EXEC after setup)." >&2
  exit 1
fi

# Load .env from SETUP if present (set -a exports all assignments).
if [[ -f "$ROOT_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
  set +a
fi

if [[ -f "$ROOT_DIR/.venv/bin/activate" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.venv/bin/activate"
fi

PYTHON="${PYTHON:-python3}"

# Map Docker-style .env values to local paths (e.g. DB_PATH=/data/arp.db from .env.example).
arp_resolve_path() {
  local val="${1:-}"
  local default_rel="${2:-}"
  if [[ -z "$val" ]]; then
    echo "$ROOT_DIR/$default_rel"
  elif [[ "$val" == /data/* ]]; then
    echo "$ROOT_DIR${val#/data}"
  elif [[ "$val" != /* ]]; then
    echo "$ROOT_DIR/$val"
  else
    echo "$val"
  fi
}

DB_PATH="$(arp_resolve_path "${DB_PATH:-}" "data/arp.db")"
CHROMA_PATH="$(arp_resolve_path "${CHROMA_PATH:-}" "data/chroma")"
export DB_PATH CHROMA_PATH

if [[ "${API_URL:-}" == *backend* ]]; then
  API_URL="http://localhost:8000"
fi
if [[ "${OLLAMA_HOST:-}" == *ollama:* ]]; then
  OLLAMA_HOST="http://localhost:11434"
fi
export API_URL OLLAMA_HOST
export OLLAMA_MODEL="${OLLAMA_MODEL:-phi3:mini}"
export OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
export API_URL="${API_URL:-http://localhost:8000}"
export ENABLE_ENHANCEMENTS="${ENABLE_ENHANCEMENTS:-1}"

# ── Market data source (mock | yahoo | alphavantage) ──────────────────────────
# Prompt interactively only when running in a terminal and the var is unset.
# Secrets are never echoed; the Alpha Vantage key is read from the environment.
if [[ -z "${MARKET_DATA_SOURCE:-}" ]]; then
  if [[ -t 0 ]]; then
    echo "Select market data source:"
    echo "  1) mock          modelled prices, offline (default)"
    echo "  2) yahoo         Yahoo Finance (live)"
    echo "  3) alphavantage  Alpha Vantage (live; needs ALPHA_VANTAGE_API_KEY)"
    read -r -p "Choice [1-3, default 1]: " _src_choice
    case "${_src_choice:-1}" in
      2) MARKET_DATA_SOURCE="yahoo" ;;
      3) MARKET_DATA_SOURCE="alphavantage" ;;
      *) MARKET_DATA_SOURCE="mock" ;;
    esac
  else
    MARKET_DATA_SOURCE="mock"
  fi
fi
export MARKET_DATA_SOURCE
# Pass through Alpha Vantage config from the environment (.env or shell).
export ALPHA_VANTAGE_API_KEY="${ALPHA_VANTAGE_API_KEY:-}"
if [[ "$MARKET_DATA_SOURCE" == "alphavantage" && -z "$ALPHA_VANTAGE_API_KEY" ]]; then
  echo "WARNING: MARKET_DATA_SOURCE=alphavantage but ALPHA_VANTAGE_API_KEY is unset."
  echo "         Set it in .env or export it; seeding will use modelled prices instead."
  echo
fi
export AV_BASE_URL="${AV_BASE_URL:-https://www.alphavantage.co/query}"
export ALPHA_VANTAGE_ENTITLEMENT="${ALPHA_VANTAGE_ENTITLEMENT:-delayed}"

export ENABLE_RAG="${ENABLE_RAG:-1}"
export VECTOR_DB="${VECTOR_DB:-local}"
export OLLAMA_EMBED_MODEL="${OLLAMA_EMBED_MODEL:-nomic-embed-text}"
export MEMORY_ENABLED="${MEMORY_ENABLED:-1}"
export MEMORY_RECALL_LIMIT="${MEMORY_RECALL_LIMIT:-3}"

export ARP_API_PORT="${ARP_API_PORT:-8000}"
export ARP_UI_PORT="${ARP_UI_PORT:-8501}"
ARP_BIND_ALL="${ARP_BIND_ALL:-0}"
ARP_RELOAD="${ARP_RELOAD:-0}"

mkdir -p "$(dirname "$DB_PATH")"

echo "==> ARP Platform"
echo "    Root:     $ROOT_DIR"
echo "    DB:       $DB_PATH"
echo "    API:      $API_URL (port $ARP_API_PORT)"
echo "    UI:       http://localhost:$ARP_UI_PORT"
echo "    Ollama:   $OLLAMA_HOST ($OLLAMA_MODEL)"
echo "    UI mode:  ENABLE_ENHANCEMENTS=$ENABLE_ENHANCEMENTS"
echo "    Reload:   ARP_RELOAD=$ARP_RELOAD (set 1 only for API dev)"
echo

echo "==> Seeding database (+ RAG knowledge index when ENABLE_RAG=1)…"
"$PYTHON" seed/seed.py
if [[ "${ENABLE_RAG:-1}" == "1" ]]; then
  echo "    RAG vector store: ${VECTOR_DB} (local JSON index | sqlite vector DB)"
  echo "    For vector embeddings: ollama pull ${OLLAMA_EMBED_MODEL}"
fi
echo

BACKEND_PID=""
cleanup() {
  if [[ -n "$BACKEND_PID" ]] && kill -0 "$BACKEND_PID" 2>/dev/null; then
    echo
    echo "==> Stopping API (pid $BACKEND_PID)…"
    kill "$BACKEND_PID" 2>/dev/null || true
    wait "$BACKEND_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

UVICORN_ARGS=(backend.main:app --port "$ARP_API_PORT")
if [[ "$ARP_BIND_ALL" == "1" ]]; then
  UVICORN_ARGS+=(--host 0.0.0.0)
else
  UVICORN_ARGS+=(--host 127.0.0.1)
fi
if [[ "$ARP_RELOAD" == "1" ]]; then
  UVICORN_ARGS+=(--reload)
fi

echo "==> Starting API…"
uvicorn "${UVICORN_ARGS[@]}" &
BACKEND_PID=$!

health_ok() {
  if command -v curl >/dev/null 2>&1; then
    curl -sf "http://127.0.0.1:${ARP_API_PORT}/health" >/dev/null 2>&1
  else
    "$PYTHON" -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${ARP_API_PORT}/health', timeout=1)" >/dev/null 2>&1
  fi
}

echo "==> Waiting for API health…"
ready=0
for _ in $(seq 1 60); do
  if health_ok; then
    ready=1
    break
  fi
  if ! kill -0 "$BACKEND_PID" 2>/dev/null; then
    echo "ERROR: API process exited before becoming healthy." >&2
    exit 1
  fi
  sleep 1
done
if [[ "$ready" -ne 1 ]]; then
  echo "ERROR: API did not respond on port $ARP_API_PORT within 60s." >&2
  exit 1
fi

echo "==> API ready — http://localhost:$ARP_API_PORT/docs"
echo "==> Starting Streamlit (Ctrl+C stops both services)…"
echo

UI_URL="http://localhost:${ARP_UI_PORT}"
STREAMLIT_ARGS=(
  run frontend/app.py
  --server.port "$ARP_UI_PORT"
  --browser.gatherUsageStats=false
)
if [[ "$ARP_BIND_ALL" == "1" ]]; then
  STREAMLIT_ARGS+=(--server.address=0.0.0.0 --server.headless=true)
else
  # headless=true: Streamlit won't open a tab; we open exactly one below on macOS.
  STREAMLIT_ARGS+=(--server.address=127.0.0.1 --server.headless=true)
  if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
    (
      for _ in $(seq 1 45); do
        if curl -sf "$UI_URL/_stcore/health" >/dev/null 2>&1 \
          || curl -sf "$UI_URL" >/dev/null 2>&1; then
          open "$UI_URL"
          break
        fi
        sleep 1
      done
    ) &
  fi
fi

exec streamlit "${STREAMLIT_ARGS[@]}"
